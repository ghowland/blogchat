{{> header}}
<h1 class="mb-4 text-2xl font-semibold">Invite a person</h1>

{{#sent}}
<div class="mb-4 rounded-md border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-900 dark:border-green-900 dark:bg-green-950 dark:text-green-200">
  The invitation is on the way. The link is valid for 7 days.
</div>
{{/sent}}

<p class="mb-4 text-zinc-600 dark:text-zinc-400">
  You give the address and the handle. The handle is the public name and you
  cannot change it later. The address stays private and no page shows it.
  Your handle appears on the profile of the new member as the inviter.
</p>

{{#error}}
<div class="mb-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800 dark:border-red-900 dark:bg-red-950 dark:text-red-300">{{error}}</div>
{{/error}}

{{#can_invite}}
<form method="post" action="/invite"
      class="flex flex-col gap-2 rounded-lg border border-zinc-200 bg-zinc-50 p-4 dark:border-zinc-800 dark:bg-zinc-900">
  <input type="hidden" name="csrf" value="{{csrf}}">

  <label for="email" class="text-sm font-semibold">Email address</label>
  <input id="email" name="email" type="email" maxlength="254" required autocomplete="off"
         class="w-full rounded-md border border-zinc-300 bg-white px-3 py-2 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-none dark:border-zinc-700 dark:bg-zinc-950">

  <label for="handle" class="mt-2 text-sm font-semibold">Handle</label>
  <input id="handle" name="handle" type="text" maxlength="24" minlength="2"
         pattern="[A-Za-z0-9_.-]{2,24}" required autocomplete="off"
         class="w-full rounded-md border border-zinc-300 bg-white px-3 py-2 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-none dark:border-zinc-700 dark:bg-zinc-950">
  <p class="text-sm text-zinc-500 dark:text-zinc-400">Letters, digits, and the signs _ - . only.</p>

  <button type="submit"
          class="mt-2 self-start rounded-md border border-zinc-300 bg-zinc-100 px-4 py-2 text-sm font-medium hover:bg-zinc-200 focus:ring-2 focus:ring-blue-500 focus:outline-none dark:border-zinc-700 dark:bg-zinc-800 dark:hover:bg-zinc-700">Send the invitation</button>
</form>
<p class="mt-3 text-sm text-zinc-500 dark:text-zinc-400">You have {{remaining}} invitations available.</p>
{{/can_invite}}

{{^can_invite}}
<div class="rounded-md border border-zinc-200 bg-zinc-50 px-4 py-3 text-sm dark:border-zinc-800 dark:bg-zinc-900">
  You have no invitations available. An invitation becomes free again when
  the person completes the first sign-in.
</div>
{{/can_invite}}
{{> footer}}
