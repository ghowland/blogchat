<article id="line{{id}}" class="group grid grid-cols-[3.5rem_6rem_minmax(0,1fr)_auto] items-baseline gap-x-2 px-1 py-0.5 text-sm hover:bg-zinc-50 dark:hover:bg-zinc-900"><span class="text-xs tabular-nums text-zinc-400 dark:text-zinc-500">{{when}}</span><span class="truncate text-right font-semibold text-blue-600 dark:text-blue-400">{{handle}}:</span><span class="whitespace-pre-wrap break-words">{{#parts}}{{#is_link}}<a href="{{url}}" target="_blank" rel="noopener noreferrer" class="underline decoration-blue-300 underline-offset-2 hover:decoration-blue-600 dark:decoration-blue-700 dark:hover:decoration-blue-400">{{text}}</a>{{/is_link}}{{^is_link}}{{text}}{{/is_link}}{{/parts}}</span>{{#can_delete}}<button type="button" title="delete" hx-post="/r/{{id}}/delete" hx-vals='{"csrf":"{{csrf}}","kind":"chat"}' hx-target="#line{{id}}" hx-swap="outerHTML" class="invisible px-1 leading-none text-red-500 group-hover:visible hover:text-red-700 dark:hover:text-red-300">&times;</button>{{/can_delete}}</article>
