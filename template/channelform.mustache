<form class="card form" method="post" action="/chat">
  <input type="hidden" name="csrf" value="{{csrf}}">
  <label for="subject">Channel name</label>
  <input id="subject" name="subject" type="text" maxlength="200" required
         autocomplete="off">
  <label for="body">Topic</label>
  <input id="body" name="body" type="text" maxlength="200"
         autocomplete="off" placeholder="optional">
  <button type="submit">Make the channel</button>
</form>
