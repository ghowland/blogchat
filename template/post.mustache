{{> header}}
{{> nav}}

{{#error}}
<div class="mb-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800 dark:border-red-900 dark:bg-red-950 dark:text-red-300">{{error}}</div>
{{/error}}

<article class="rounded-lg border border-zinc-200 bg-zinc-50 p-4 dark:border-zinc-800 dark:bg-zinc-900">
  <h1 class="text-xl font-semibold">{{post.subject}}</h1>
  <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">{{post.handle}} &middot; {{post.when}}</p>
  <div class="mt-3 break-words whitespace-pre-wrap">{{post.body}}</div>
  {{#owner}}
  <form method="post" action="/p/{{post.id}}/delete" class="mt-4">
    <input type="hidden" name="csrf" value="{{csrf}}">
    <input type="hidden" name="kind" value="post">
    <button type="submit"
            class="rounded-md border border-red-300 px-3 py-1.5 text-sm font-medium text-red-700 hover:bg-red-50 focus:ring-2 focus:ring-red-500 focus:outline-none dark:border-red-900 dark:text-red-400 dark:hover:bg-red-950">Delete this post</button>
  </form>
  {{/owner}}
</article>

<h2 class="mt-8 border-t border-zinc-200 pt-4 text-lg font-semibold dark:border-zinc-800">{{reply_count}} replies</h2>

<div class="divide-y divide-zinc-200 dark:divide-zinc-800">
{{#replies}}
  <article class="group py-4">
    <p class="flex items-center gap-2 text-sm text-zinc-500 dark:text-zinc-400">
      <span>{{handle}} &middot; {{when}}</span>
      {{#can_delete}}
      <form method="post" action="/r/{{id}}/delete" class="inline">
        <input type="hidden" name="csrf" value="{{csrf}}">
        <input type="hidden" name="post" value="{{post.id}}">
        <input type="hidden" name="kind" value="post">
        <button type="submit"
                class="invisible text-red-600 underline group-hover:visible hover:no-underline dark:text-red-400">delete</button>
      </form>
      {{/can_delete}}
    </p>
    <div class="mt-2 break-words whitespace-pre-wrap">{{body}}</div>
  </article>
{{/replies}}
</div>

{{> replyform}}
{{> footer}}
