{{> header}}
<h1 class="mb-4 text-2xl font-semibold">Channels</h1>

{{#error}}
<div class="mb-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800 dark:border-red-900 dark:bg-red-950 dark:text-red-300">{{error}}</div>
{{/error}}

{{> channelform}}

{{#empty}}
<div class="rounded-md border border-zinc-200 bg-zinc-50 px-4 py-3 text-sm dark:border-zinc-800 dark:bg-zinc-900">
  There are no channels. Make the first one.
</div>
{{/empty}}

<div class="divide-y divide-zinc-200 dark:divide-zinc-800">
{{#posts}}
  <article class="py-3">
    <h2 class="text-base font-semibold">
      <a href="/c/{{id}}" class="text-blue-600 no-underline hover:underline dark:text-blue-400">{{subject}}</a>
    </h2>
    <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">{{handle}} &middot; {{replies}} messages &middot; last {{when}}</p>
  </article>
{{/posts}}
</div>

<nav class="mt-6 flex items-center gap-4 text-sm">
  {{#has_prev}}<a href="{{base}}?page={{prev_page}}" class="text-blue-600 hover:underline dark:text-blue-400">Newer</a>{{/has_prev}}
  <span class="text-zinc-500 dark:text-zinc-400">Page {{page}}</span>
  {{#has_next}}<a href="{{base}}?page={{next_page}}" class="text-blue-600 hover:underline dark:text-blue-400">Older</a>{{/has_next}}
</nav>

<p class="mt-6 text-sm text-zinc-500 dark:text-zinc-400">
  Each channel keeps the newest {{keep}} messages. Older messages are removed
  and cannot be recovered.
</p>
{{> footer}}
