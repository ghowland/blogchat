{{> header}}
<h1>Channels</h1>

{{#error}}<p class="error">{{error}}</p>{{/error}}

{{> channelform}}

{{#empty}}
<p class="notice">There are no channels. Make the first one.</p>
{{/empty}}

{{#posts}}
<article class="row">
  <h2><a href="/c/{{id}}">{{subject}}</a></h2>
  <p class="meta">{{handle}} &middot; {{replies}} messages &middot; last {{when}}</p>
</article>
{{/posts}}

<nav class="pages">
  {{#has_prev}}<a href="{{base}}?page={{prev_page}}">Newer</a>{{/has_prev}}
  <span>Page {{page}}</span>
  {{#has_next}}<a href="{{base}}?page={{next_page}}">Older</a>{{/has_next}}
</nav>

<p class="small">
  Each channel keeps the newest {{keep}} messages. Older messages are removed
  and cannot be recovered.
</p>
{{> footer}}

