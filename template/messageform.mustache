<!-- The method and the action stay. Without the library, this is a normal
     form post and the redirect path in the handler still works. -->
<form id="msgform" class="msgform"
      method="post" action="/c/{{post.id}}/m"
      hx-post="/c/{{post.id}}/m" hx-swap="none">
  <input type="hidden" name="csrf" value="{{csrf}}">
  <textarea id="message" name="body" rows="1" maxlength="2048" required
            enterkeyhint="send" autocomplete="off"
            placeholder="Message. Enter sends. Shift and Enter make a new line."></textarea>
  <button type="submit">Send</button>
</form>
