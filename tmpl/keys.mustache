{{> header}}
<h1>Your keys</h1>

{{#notice}}<p class="notice">{{notice}}</p>{{/notice}}

<p class="lead">
  Each line is one sign-in on one device. Remove the other keys if you do not
  know a line, or if you used a device that is not yours. Those devices then
  need a new sign-in link.
</p>

<table class="keys">
<thead>
<tr><th>Signed in</th><th>Last seen</th><th>Address</th><th>Device</th><th></th></tr>
</thead>
<tbody>
{{#sessions}}
<tr class="{{#current}}now{{/current}}">
  <td>{{when}}</td>
  <td>{{last}}</td>
  <td>{{ip}}</td>
  <td class="agent">{{agent}}</td>
  <td>{{#current}}this device{{/current}}</td>
</tr>
{{/sessions}}
</tbody>
</table>

{{#has_others}}
<form class="card form" method="post" action="/keys/revoke-others">
  <input type="hidden" name="csrf" value="{{csrf}}">
  <p>You have {{others}} other keys. This device keeps its key.</p>
  <button class="danger" type="submit">Remove all other keys</button>
</form>
{{/has_others}}

{{^has_others}}
<p class="notice">This device holds the only key.</p>
{{/has_others}}

<h2>Your account</h2>
<dl class="facts">
  <dt>Handle</dt><dd>{{handle}}</dd>
  <dt>Invited by</dt><dd>{{inviter}}</dd>
  <dt>Member since</dt><dd>{{joined}}</dd>
</dl>
{{> footer}}

