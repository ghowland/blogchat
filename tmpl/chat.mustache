{{> header}}
<div class="chatpage">

  <div class="chathead">
    <div class="chattitle">
      <h1>{{post.subject}}</h1>
      {{#has_topic}}<p class="topic">{{post.body}}</p>{{/has_topic}}
    </div>
    <div class="chatmeta">
      <a href="/chat">All channels</a>
      <span>{{post.handle}} &middot; keeps {{keep}}</span>
      {{#owner}}
      <form class="inline" method="post" action="/c/{{post.id}}/delete">
        <input type="hidden" name="csrf" value="{{csrf}}">
        <input type="hidden" name="kind" value="chat">
        <button class="link danger" type="submit">delete channel</button>
      </form>
      {{/owner}}
    </div>
  </div>

  {{#error}}<p class="error">{{error}}</p>{{/error}}

  <div class="lines" id="lines">
    {{#empty}}<p class="notice">There are no messages. Send the first one.</p>{{/empty}}
    {{#lines}}{{> line}}{{/lines}}
    <div id="poller"
         hx-get="/c/{{channel_id}}/lines?after={{last_id}}"
         hx-trigger="every 3s, newmsg from:body"
         hx-swap="outerHTML"></div>
  </div>

  {{> messageform}}
</div>
<script src="/static/chat.js" defer></script>
</body>
</html>
