{{> header}}
<p class="back"><a href="/chat">Back to the channels</a></p>

{{#error}}<p class="error">{{error}}</p>{{/error}}

<div class="card">
  <h1>{{post.subject}}</h1>
  {{#has_topic}}<p class="lead">{{post.body}}</p>{{/has_topic}}
  <p class="meta">Started by {{post.handle}} &middot; {{post.when}}</p>
  {{#owner}}
  <form class="inline" method="post" action="/c/{{post.id}}/delete">
    <input type="hidden" name="csrf" value="{{csrf}}">
    <input type="hidden" name="kind" value="chat">
    <button class="danger" type="submit">Delete this channel</button>
  </form>
  {{/owner}}
</div>

{{> messageform}}

<p class="small">
  This channel keeps the newest {{keep}} messages. Older messages are removed
  and cannot be recovered.
</p>

{{#empty}}
<p class="notice">There are no messages. Send the first one.</p>
{{/empty}}

{{#lines}}
<article class="line">
  <p class="meta">
    {{handle}} &middot; {{when}}
    {{#can_delete}}
    <form class="inline" method="post" action="/r/{{id}}/delete">
      <input type="hidden" name="csrf" value="{{csrf}}">
      <input type="hidden" name="post" value="{{post.id}}">
      <input type="hidden" name="kind" value="chat">
      <button class="link danger" type="submit">delete</button>
    </form>
    {{/can_delete}}
  </p>
  <div class="body">{{body}}</div>
</article>
{{/lines}}

{{> footer}}

